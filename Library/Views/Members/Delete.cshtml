
@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>
@model Library.Models.Member

@{
    ViewBag.Title = "Xóa thành viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Xác nhận xóa thành viên</h4>
        </div>
        <div class="card-body">
            <h5 class="text-danger mb-3">Bạn có chắc chắn muốn xóa thành viên này không?</h5>

            <dl class="row">
                <dt class="col-sm-4">Họ tên:</dt>
                <dd class="col-sm-8">@Model.FullName</dd>

                <dt class="col-sm-4">Email:</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Số điện thoại:</dt>
                <dd class="col-sm-8">@Model.Phone</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="mt-4">
                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                    @Html.ActionLink("Hủy bỏ, quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
                </div>
            }
        </div>
    </div>
</div>

