
@model IEnumerable<Library.Models.Book>
@using System.Collections.Generic
@using System.Linq

@{
    bool canManage = ViewBag.CanManageBooks == true;

    ViewBag.Title = canManage
        ? "Quản lý sách"
        : "Danh mục sách";

    Layout = "~/Views/Shared/LibraryLayout.cshtml";

    var books = Model == null
        ? new List<Library.Models.Book>()
        : Model.ToList();
}

<style>
    /* Giao diện danh mục dành cho khách và Reader */
    .bn-catalog-heading {
        margin-bottom: 26px;
    }

        .bn-catalog-heading h1 {
            color: #1d2041;
            font-size: 30px;
            font-weight: 750;
            margin-bottom: 8px;
        }

        .bn-catalog-heading p {
            color: #747991;
            margin: 0;
        }

    .bn-catalog-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .bn-catalog-card {
        min-width: 0;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #e5e6f0;
        border-radius: 16px;
        padding: 16px;
        transition: transform .2s, box-shadow .2s;
    }

        .bn-catalog-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(35, 37, 98, .10);
        }

    .bn-catalog-cover {
        position: relative;
        height: 245px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f0fa;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 16px;
    }

        .bn-catalog-cover img {
            display: block;
            height: 100%;
            max-width: 100%;
            object-fit: contain;
            position: relative;
            z-index: 1;
        }

    .bn-catalog-placeholder {
        position: absolute;
        font-size: 55px;
        font-weight: 700;
        color: #b6b6da;
    }

    .bn-catalog-title {
        color: #292d8a;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.4;
        text-decoration: none;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .bn-catalog-title:hover {
            color: #5558d2;
        }

    .bn-catalog-meta {
        font-size: 13px;
        color: #6c7189;
        margin-bottom: 5px;
    }

    .bn-catalog-description {
        font-size: 13px;
        color: #646980;
        line-height: 1.6;
        margin: 12px 0 16px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 62px;
    }

    .bn-catalog-footer {
        margin-top: auto;
    }

    .bn-catalog-status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .bn-catalog-instock {
        background: #e4f5eb;
        color: #147c49;
    }

    .bn-catalog-outstock {
        background: #fde8e8;
        color: #b32635;
    }

    .bn-catalog-detail {
        display: block;
        width: 100%;
        text-align: center;
        background: #30348f;
        color: white;
        padding: 11px;
        border-radius: 9px;
        font-weight: 650;
        text-decoration: none;
    }

        .bn-catalog-detail:hover {
            background: #24276f;
            color: white;
        }

    @@media (max-width: 1100px) {
        .bn-catalog-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .bn-catalog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 15px;
        }
    }

    @@media (max-width: 480px) {
        .bn-catalog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


@if (canManage)
{
    <!-- ======================================= -->
    <!-- GIAO DIỆN ADMIN VÀ LIBRARIAN            -->
    <!-- ======================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Quản lý sách</h1>
            <p class="text-muted mb-0">
                Danh sách sách trong thư viện (@books.Count đầu sách)
            </p>
        </div>

        <a href="@Url.Action("Create", "Books")" class="bn-btn">
            + Thêm sách mới
        </a>
    </div>

    <div class="bn-panel">
        @if (books.Count == 0)
        {
            <div class="text-center py-4">
                <p class="text-muted mb-3">
                    Chưa có sách nào trong thư viện.
                </p>
                <a href="@Url.Action("Create", "Books")"
                   class="btn btn-primary">
                    Thêm sách đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle bn-table mb-0">
                    <thead>
                        <tr>
                            <th>Mã sách</th>
                            <th>Thông tin sách</th>
                            <th>Thể loại</th>
                            <th>Tác giả</th>
                            <th class="text-end">Giá</th>
                            <th>Số lượng</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in books)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.BookID
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bn-thumb flex-shrink-0">
                                            <span>
                                                @(string.IsNullOrEmpty(item.Title)
                                                    ? "B"
                                                    : item.Title.Substring(0, 1))
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img src="@Url.Content("~/Content/images/" + item.ImageUrl)"
                                                     alt="Bìa sách @item.Title"
                                                     onerror="this.style.display='none'" />
                                            }
                                        </div>

                                        <div>
                                            <a class="fw-semibold"
                                               href="@Url.Action("Details", "Books", new { id = item.BookID })">
                                                @item.Title
                                            </a>

                                            <div class="small text-muted text-truncate"
                                                 style="max-width:250px;"
                                                 title="@item.Description">
                                                @(string.IsNullOrWhiteSpace(item.Description)
                                                    ? "Chưa có mô tả"
                                                    : item.Description)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @(item.Category != null
                                        ? item.Category.CategoryName
                                        : "—")
                                </td>

                                <td>
                                    @(item.Author != null
                                        ? item.Author.AuthorName
                                        : "—")
                                </td>

                                <td class="text-end text-nowrap">
                                    @item.Price.ToString("N0") đ
                                </td>

                                <td>
                                    @if (item.StockQuantity > 0)
                                    {
                                        <span class="bn-badge-ok">
                                            @item.StockQuantity bản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bn-badge-out">
                                            Hết sách
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsActive == true)
                                    {
                                        <span class="bn-badge-ok">
                                            Đang hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bn-badge-out">
                                            Đã ẩn
                                        </span>
                                    }
                                </td>


                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="@Url.Action("Details", "Books", new { id = item.BookID })">
                                            Chi tiết
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="@Url.Action("Edit", "Books", new { id = item.BookID })">
                                            Sửa
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger"
                                           href="@Url.Action("Delete", "Books", new { id = item.BookID })">
                                            Xóa
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <!-- ======================================= -->
    <!-- GIAO DIỆN READER VÀ KHÁCH               -->
    <!-- ======================================= -->

    <div class="bn-catalog-heading">
        <h1>Khám phá kho sách BookNest</h1>
        <p>
            Tra cứu và khám phá các đầu sách trong thư viện.
            Hiện có @books.Count đầu sách.
        </p>
    </div>

    if (books.Count == 0)
    {
        <div class="bn-panel text-center py-5">
            <h4>Chưa có sách nào để hiển thị</h4>
            <p class="text-muted">
                Vui lòng quay lại sau.
            </p>
        </div>
    }
    else
    {
        <div class="bn-catalog-grid">
            @foreach (var item in books)
            {
                <div class="bn-catalog-card">

                    <!-- Ảnh bìa -->
                    <div class="bn-catalog-cover">
                        <span class="bn-catalog-placeholder">
                            @(string.IsNullOrWhiteSpace(item.Title)
                                ? "B"
                                : item.Title.Substring(0, 1))
                        </span>

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@Url.Content("~/Content/images/" + item.ImageUrl)"
                                 alt="Bìa sách @item.Title"
                                 loading="lazy"
                                 onerror="this.style.display='none'" />
                        }
                    </div>

                    <!-- Tên sách -->
                    <a class="bn-catalog-title"
                       href="@Url.Action("Details", "Books", new { id = item.BookID })">
                        @item.Title
                    </a>

                    <!-- Tác giả -->
                    <div class="bn-catalog-meta">
                        Tác giả:
                        @(item.Author != null
                            ? item.Author.AuthorName
                            : "Chưa cập nhật")
                    </div>

                    <!-- Thể loại -->
                    <div class="bn-catalog-meta">
                        Thể loại:
                        @(item.Category != null
                            ? item.Category.CategoryName
                            : "Chưa cập nhật")
                    </div>

                    <!-- Tóm tắt -->
                    <p class="bn-catalog-description">
                        @(string.IsNullOrWhiteSpace(item.Description)
                            ? "Cuốn sách chưa có nội dung tóm tắt."
                            : item.Description)
                    </p>

                    <div class="bn-catalog-footer">

                        <!-- Trạng thái sách -->
                        @if (item.StockQuantity > 0)
                        {
                            <div>
                                <span class="bn-catalog-status bn-catalog-instock">
                                    Còn sách (@item.StockQuantity bản)
                                </span>
                            </div>
                        }
                        else
                        {
                            <div>
                                <span class="bn-catalog-status bn-catalog-outstock">
                                    Hết sách
                                </span>
                            </div>
                        }

                        <!-- Xem chi tiết -->
                        <a class="bn-catalog-detail"
                           href="@Url.Action("Details", "Books", new { id = item.BookID })">
                            Xem chi tiết
                        </a>

                    </div>
                </div>
            }
        </div>
    }
}
