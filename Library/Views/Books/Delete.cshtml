@model Library.Models.Book

@{
    ViewBag.Title = "Xác nhận xóa sách";
    Layout = "~/Views/Shared/LibraryLayout.cshtml";
}

<!-- TIÊU ĐỀ -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Xác nhận xóa sách</h1>
        <p class="text-muted mb-0">Kiểm tra thông tin trước khi xóa sách khỏi hệ thống.</p>
    </div>
    <a href="@Url.Action("Index", "Books")" class="btn btn-outline-secondary">Quay về danh sách</a>
</div>

<!-- XÁC NHẬN XÓA -->
<div class="bn-panel">
    <div class="alert alert-warning" role="alert">
        <strong>Bạn có chắc chắn muốn xóa cuốn sách này?</strong>
        Thao tác sẽ xóa bản ghi khỏi cơ sở dữ liệu và không thể hoàn tác trực tiếp trên website.
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-sm-4 col-lg-3">
            <div class="bn-cover" style="max-width:220px; margin:0 auto;">
                <span>@Model.Title</span>
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Url.Content("~/Content/images/" + Model.ImageUrl)"
                         alt="Ảnh bìa sách @Model.Title"
                         onerror="this.style.display='none'" />
                }
            </div>
        </div>

        <div class="col-sm-8 col-lg-9">
            <h2 class="h5 fw-bold mb-3">@Model.Title</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4 mb-2">Mã sách</dt>
                <dd class="col-sm-8 mb-2">@Model.BookID</dd>

                <dt class="col-sm-4 mb-2">Thể loại</dt>
                <dd class="col-sm-8 mb-2">@(Model.Category != null ? Model.Category.CategoryName : "Chưa có thông tin")</dd>

                <dt class="col-sm-4 mb-2">Tác giả</dt>
                <dd class="col-sm-8 mb-2">@(Model.Author != null ? Model.Author.AuthorName : "Chưa có thông tin")</dd>

                <dt class="col-sm-4 mb-2">Giá sách</dt>
                <dd class="col-sm-8 mb-2">@Model.Price.ToString("N0") VNĐ</dd>

                <dt class="col-sm-4 mb-2">Số lượng trong kho</dt>
                <dd class="col-sm-8 mb-2">@Model.StockQuantity bản</dd>
            </dl>
        </div>
    </div>

    <hr class="my-4" />

    <!-- GIỮ NGUYÊN LUỒNG POST XÓA CỦA MVC SCAFFOLDING -->
    @using (Html.BeginForm("Delete", "Books", new { id = Model.BookID }, FormMethod.Post, null))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.BookID)

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a href="@Url.Action("Details", "Books", new { id = Model.BookID })" class="btn btn-outline-secondary">Hủy, quay về chi tiết</a>
            <a href="@Url.Action("Index", "Books")" class="btn btn-outline-secondary">Danh sách sách</a>
        </div>
    }
</div>
