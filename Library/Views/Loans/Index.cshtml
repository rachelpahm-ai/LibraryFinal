
@model IEnumerable<Library.Models.Loan>

@{
    ViewBag.Title = "Danh sách phiếu mượn";
    Layout = "~/Views/Shared/LibraryLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
}

<div class="container-fluid mt-4">

    <h2 class="mb-4">Quản lý mượn – trả sách</h2>

    <!-- Khung tìm kiếm và lọc -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-center mb-3">
                <div class="col-md-6">

                    @Html.ActionLink(
                             "+ Tạo phiếu mượn mới",
                             "Create",
                             "Loans",
                             null,
                             new { @class = "bn-btn bn-btn--primary" }
                         )

                </div>
            </div>

            @using (Html.BeginForm(
                "Index",
                "Loans",
                FormMethod.Get,
                new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-4">

                    <label class="form-label">
                        Tìm theo tên thành viên
                    </label>

                    <input type="text"
                           name="searchName"
                           value="@ViewBag.SearchName"
                           class="form-control"
                           placeholder="Nhập tên thành viên..." />

                </div>

                <div class="col-md-2">

                    <label class="form-label">
                        Trạng thái
                    </label>

                    <select name="status" class="form-select">

                        <option value="">-- Tất cả --</option>

                        <option value="DangMuon"
                                @(ViewBag.Status == "DangMuon" ? "selected" : "")>
                            Đang mượn
                        </option>

                        <option value="DaTra"
                                @(ViewBag.Status == "DaTra" ? "selected" : "")>
                            Đã trả
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <label class="form-label">
                        Sắp xếp
                    </label>

                    <select name="sortOrder" class="form-select">

                        <option value="newest"
                                @(ViewBag.SortOrder != "oldest" ? "selected" : "")>
                            Mới nhất
                        </option>

                        <option value="oldest"
                                @(ViewBag.SortOrder == "oldest" ? "selected" : "")>
                            Cũ nhất
                        </option>

                    </select>

                </div>

                <div class="col-md-4">

                    <div class="bn-actions">

                        <button type="submit"
                                class="bn-btn bn-btn--primary">
                            Tìm kiếm
                        </button>

                        <a href="@Url.Action("Index", "Loans")"
                           class="bn-btn bn-btn--edit">
                            Làm mới
                        </a>

                    </div>

                </div>
            }

        </div>
    </div>

    <!-- Bảng danh sách phiếu mượn -->
    <div class="card shadow-sm">

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle bn-table">

                <thead class="table-light">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Thành viên</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th class="text-center">Số lượng sách</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>#@item.LoanID</strong>
                                </td>

                                <td>
                                    @(item.Member != null
                                        ? item.Member.FullName : "")
                                </td>

                                <td>
                                    @item.LoanDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.DueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    @(item.LoanDetails != null
                                        ? item.LoanDetails.Sum(d => d.Quantity)
                                        : 0)
                                </td>

                                <!-- Trạng thái phiếu mượn -->
                                <td class="text-center">

                                    @if (item.ReturnDate != null)
                                    {
                                        <span class="badge bn-badge-ok bg-success text-white">
                                            Đã trả
                                        </span>
                                    }
                                    else if (item.DueDate.Date < DateTime.Today)
                                    {
                                        <span class="badge bn-badge-out bg-danger text-white">
                                            Quá hạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Đang mượn
                                        </span>
                                    }

                                </td>

                                <!-- Nút thao tác -->
                                <td class="text-center">

                                    <div class="bn-actions justify-content-center">

                                        @Html.ActionLink(
                                                 "Chi tiết",
                                                 "Details",
                                                 new { id = item.LoanID },
                                                 new { @class = "bn-btn bn-btn--view" }
                                             )

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center text-muted py-4">

                                Không tìm thấy phiếu mượn nào.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Thanh phân trang -->
    @if (totalPages > 1)
    {
        <div class="text-center mt-4">

            <p class="text-muted">
                Trang @currentPage / @totalPages
            </p>

            <div class="bn-actions justify-content-center">

                @if (currentPage > 1)
                {
                    @Html.ActionLink(
                             "Trang trước",
                             "Index",
                             new
                             {
                                 searchName = ViewBag.SearchName,
                                 status = ViewBag.Status,
                                 sortOrder = ViewBag.SortOrder,
                                 page = currentPage - 1
                             },
                             new { @class = "bn-btn bn-btn--edit" }
                         )
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="bn-btn bn-btn--primary">
                            @i
                        </span>
                    }
                    else
                    {
                        @Html.ActionLink(
                                 i.ToString(),
                                 "Index",
                                 new
                                 {
                                     searchName = ViewBag.SearchName,
                                     status = ViewBag.Status,
                                     sortOrder = ViewBag.SortOrder,
                                     page = i
                                 },
                                 new { @class = "bn-btn bn-btn--view" }
                             )
                    }
                }

                @if (currentPage < totalPages)
                {
                    @Html.ActionLink(
                             "Trang sau",
                             "Index",
                             new
                             {
                                 searchName = ViewBag.SearchName,
                                 status = ViewBag.Status,
                                 sortOrder = ViewBag.SortOrder,
                                 page = currentPage + 1
                             },
                             new { @class = "bn-btn bn-btn--edit" }
                         )
                }

            </div>

        </div>
    }

</div>
