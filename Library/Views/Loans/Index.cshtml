@model IEnumerable<Library.Models.Loan>

@{
    ViewBag.Title = "Danh sách phiếu mượn";
}

<h2>Danh sách phiếu mượn</h2>

<p>
    @Html.ActionLink("Tạo phiếu mượn mới", "Create", "Loans", null,
        new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "Loans", FormMethod.Get))
{
    <div class="form-group">
        <label>Tìm theo tên thành viên</label>
        <input type="text" name="searchName"
               value="@ViewBag.SearchName"
               class="form-control" />
    </div>

    <div class="form-group">
        <label>Trạng thái</label>
        <select name="status" class="form-control">
            <option value="">-- Tất cả --</option>
            <option value="DangMuon"
                    @(ViewBag.Status == "DangMuon" ? "selected" : "")>
                Đang mượn
            </option>
            <option value="DaTra"
                    @(ViewBag.Status == "DaTra" ? "selected" : "")>
                Đã trả
            </option>
        </select>
    </div>

    <div class="form-group">
        <label>Sắp xếp</label>
        <select name="sortOrder" class="form-control">
            <option value="newest"
                    @(ViewBag.SortOrder != "oldest" ? "selected" : "")>
                Mới nhất
            </option>
            <option value="oldest"
                    @(ViewBag.SortOrder == "oldest" ? "selected" : "")>
                Cũ nhất
            </option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Tìm kiếm
    </button>
}

<hr />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã phiếu</th>
            <th>Thành viên</th>
            <th>Ngày mượn</th>
            <th>Hạn trả</th>
            <th>Số lượng sách</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.LoanID</td>

                    <td>
                        @(item.Member != null ? item.Member.FullName : "")
                    </td>

                    <td>@item.LoanDate.ToString("dd/MM/yyyy")</td>

                    <td>@item.DueDate.ToString("dd/MM/yyyy")</td>

                    <td>
                        @(item.LoanDetails != null
                            ? item.LoanDetails.Count : 0)
                    </td>

                    <td>
                        @if (item.ReturnDate == null)
                        {
                            <span>Đang mượn</span>
                        }
                        else
                        {
                            <span>Đã trả</span>
                        }
                    </td>

                    <td>
                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.LoanID },
                            new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    Không tìm thấy phiếu mượn nào.
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
}

@if (totalPages > 1)
{
    <div class="text-center">
        <p>
            Trang @currentPage / @totalPages
        </p>

        <div>
            @if (currentPage > 1)
            {
                @Html.ActionLink("Trang trước", "Index",
                    new
                    {
                        searchName = ViewBag.SearchName,
                        status = ViewBag.Status,
                        sortOrder = ViewBag.SortOrder,
                        page = currentPage - 1
                    },
                    new { @class = "btn btn-secondary" })
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <span class="btn btn-primary">@i</span>
                }
                else
                {
                    @Html.ActionLink(i.ToString(), "Index",
                        new
                        {
                            searchName = ViewBag.SearchName,
                            status = ViewBag.Status,
                            sortOrder = ViewBag.SortOrder,
                            page = i
                        },
                        new { @class = "btn btn-outline-primary" })
                }
            }

            @if (currentPage < totalPages)
            {
                @Html.ActionLink("Trang sau", "Index",
                    new
                    {
                        searchName = ViewBag.SearchName,
                        status = ViewBag.Status,
                        sortOrder = ViewBag.SortOrder,
                        page = currentPage + 1
                    },
                    new { @class = "btn btn-secondary" })
            }
        </div>
    </div>
}