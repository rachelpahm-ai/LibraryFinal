@model IEnumerable<Library.Models.Account>

@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Views/Shared/LibraryLayout.cshtml";
}

<div class="container-fluid mt-4">

    <h2 class="mb-4">Quản lý tài khoản</h2>

    <!-- Khung thêm tài khoản -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            @Html.ActionLink(
                     "+ Thêm tài khoản mới",
                     "Create",
                     null,
                     new { @class = "bn-btn bn-btn--primary" }
                 )

        </div>
    </div>

    <!-- Bảng danh sách tài khoản -->
    <div class="card shadow-sm">

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle bn-table">

                <thead class="table-light">
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th class="text-center">Vai trò</th>
                        <th class="text-center" style="min-width: 220px;">
                            Thao tác
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Tên đăng nhập -->
                                <td>
                                    <strong>
                                        @item.Username
                                    </strong>
                                </td>

                                <!-- Vai trò tài khoản -->
                                <td class="text-center">

                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge"
                                              style="background-color: #34348f; color: #fff;">
                                            Admin
                                        </span>
                                    }
                                    else if (item.Role == "Librarian")
                                    {
                                        <span class="badge bg-success text-white">
                                            Librarian
                                        </span>
                                    }
                                    else if (item.Role == "Reader")
                                    {
                                        <span class="badge bg-secondary text-white">
                                            Reader
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white">
                                            @item.Role
                                        </span>
                                    }

                                </td>

                                <!-- Các nút thao tác -->
                                <td>

                                    <div class="bn-actions justify-content-center">

                                        @Html.ActionLink(
                                                 "Chi tiết",
                                                 "Details",
                                                 new { id = item.AccountID },
                                                 new { @class = "bn-btn bn-btn--view" }
                                             )

                                        @Html.ActionLink(
                                                 "Sửa",
                                                 "Edit",
                                                 new { id = item.AccountID },
                                                 new { @class = "bn-btn bn-btn--edit" }
                                             )

                                        @Html.ActionLink(
                                                 "Xóa",
                                                 "Delete",
                                                 new { id = item.AccountID },
                                                 new { @class = "bn-btn bn-btn--delete" }
                                             )

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center text-muted py-4">

                                Chưa có tài khoản nào trong hệ thống.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>