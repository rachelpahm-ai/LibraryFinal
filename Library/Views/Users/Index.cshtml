
@model IEnumerable<Library.Models.Account>

@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Views/Shared/LibraryLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4">Danh sách tài khoản</h2>

    <p>
        @Html.ActionLink(
            "Thêm tài khoản mới",
            "Create",
            null,
            new { @class = "btn btn-primary" }
        )
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò</th>
                    <th style="width: 260px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Username)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Role)
                            </td>

                            <td>
                                @Html.ActionLink(
                                    "Sửa",
                                    "Edit",
                                    new { id = item.AccountID },
                                    new { @class = "btn btn-warning btn-sm" }
                                )

                                @Html.ActionLink(
                                    "Chi tiết",
                                    "Details",
                                    new { id = item.AccountID },
                                    new { @class = "btn btn-info btn-sm" }
                                )

                                @Html.ActionLink(
                                    "Xóa",
                                    "Delete",
                                    new { id = item.AccountID },
                                    new { @class = "btn btn-danger btn-sm" }
                                )
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            Chưa có tài khoản nào trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
