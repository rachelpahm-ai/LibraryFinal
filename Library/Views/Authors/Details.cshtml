@model Library.Models.Author

@{
    ViewBag.Title = "Chi tiết Tác giả";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Chi tiết Tác giả</h2>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-3">Tên tác giả:</dt>
            <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.AuthorName)</dd>
        </dl>
    </div>

    <h4 class="mt-4">Danh sách sách của tác giả</h4>
    @if (Model.Books != null && Model.Books.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-secondary">
                <tr>
                    <th>Tên sách</th>
                    <th>Giá</th>
                    <th>Số lượng tồn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Price</td>
                        <td>@book.StockQuantity</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Chưa có cuốn sách nào thuộc tác giả này.</p>
    }

    <p class="mt-3">
        @Html.ActionLink("Sửa", "Edit", new { id = Model.AuthorID }, new { @class = "btn btn-warning" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </p>
</div>