@model IEnumerable<Library.Models.Author>

@{
    ViewBag.Title = "Quản lý Tác giả";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <!-- Tiêu đề trang chuẩn ảnh mẫu -->
    <h2 class="fw-bold text-dark mb-4">Quản lý Tác giả</h2>

    <!-- Thông báo nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-3">@TempData["Error"]</div>
    }

    <!-- Khối Card Lọc & Thêm mới (Giống hệt ảnh mẫu) -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <!-- Nút Thêm mới nằm ở hàng đầu tiên inside card -->
        <div class="mb-3">
            @Html.ActionLink("Thêm tác giả mới", "Create", null, new { @class = "btn text-white fw-semibold px-4 py-2 rounded-3", @style = "background-color: #2B3688;" })
        </div>

        <!-- Hàng tìm kiếm, bộ lọc và các nút -->
        @using (Html.BeginForm("Index", "Authors", FormMethod.Get, new { @class = "row g-3 align-items-center" }))
        {
            <div class="col-md-5">
                <input type="text" name="searchString" class="form-control py-2 px-3 rounded-3 border-light-subtle" placeholder="Tìm kiếm theo tên tác giả..." value="@ViewBag.CurrentSearch" />
            </div>
            
            <div class="col-md-3">
                <select name="filter" class="form-select py-2 px-3 rounded-3 border-light-subtle">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="HasBooks" @(ViewBag.CurrentFilter == "HasBooks" ? "selected" : "")>Có sách</option>
                    <option value="NoBooks" @(ViewBag.CurrentFilter == "NoBooks" ? "selected" : "")>Chưa có sách</option>
                </select>
            </div>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn text-white px-4 py-2 fw-semibold rounded-3" style="background-color: #5A626A;">Lọc dữ liệu</button>
                @Html.ActionLink("Làm mới", "Index", null, new { @class = "btn btn-outline-secondary px-3 py-2 fw-semibold rounded-3" })
            </div>
        }
    </div>

    <!-- Bảng danh sách Tác giả (Giống hệt ảnh mẫu) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary small fw-semibold">
                        <th class="py-3 ps-4">Tên tác giả</th>
                        <th class="py-3 text-center" style="width: 280px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center py-4 text-muted">
                                Không tìm thấy dữ liệu tác giả nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    @item.AuthorName
                                </td>
                                <td class="text-center py-3">
                                    @Html.ActionLink("Xem", "Details", new { id = item.AuthorID }, new { @class = "btn btn-info btn-sm text-white px-3 me-1 rounded-2" })
                                    @Html.ActionLink("Sửa", "Edit", new { id = item.AuthorID }, new { @class = "btn btn-warning btn-sm text-dark px-3 me-1 rounded-2" })
                                    @Html.ActionLink("Xóa", "Delete", new { id = item.AuthorID }, new { @class = "btn btn-danger btn-sm px-3 rounded-2" })
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>