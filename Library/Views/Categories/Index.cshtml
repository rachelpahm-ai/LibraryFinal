@model IEnumerable<Library.Models.Category>

@{
    ViewBag.Title = "Quản lý Thể loại";
}

<div class="container py-4">
    <!-- Header trang & Nút thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý Thể loại</h2>
            <p class="text-muted small mb-0">Danh sách các thể loại sách hiện có trong hệ thống</p>
        </div>
        @Html.ActionLink("Thêm thể loại mới", "Create", null, new { @class = "btn btn-primary px-4 py-2 fw-bold rounded-3 shadow-sm" })
    </div>

    <!-- Thông báo lỗi (nếu bị chặn xóa) -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        </div>
    }

    <!-- Bảng danh sách Thể loại -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 ps-4 text-secondary text-uppercase fs-7">Tên thể loại</th>
                        <th class="py-3 text-secondary text-uppercase fs-7 text-center">Số lượng sách</th>
                        <th class="py-3 text-center text-secondary text-uppercase fs-7" style="width: 260px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                @item.CategoryName
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-normal">
                                    @item.Books.Count cuốn
                                </span>
                            </td>
                            <td class="text-center py-3">
                                @Html.ActionLink("Xem", "Details", new { id = item.CategoryID }, new { @class = "btn btn-info btn-sm text-white px-3 me-1 fw-semibold rounded-2" })
                                @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-warning btn-sm text-dark px-3 me-1 fw-semibold rounded-2" })
                                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm px-3 fw-semibold rounded-2" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>