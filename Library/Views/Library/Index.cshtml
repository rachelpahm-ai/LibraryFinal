
@model IEnumerable<Library.Models.BookCardViewModel>
@using System
@using System.Linq

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/LibraryLayout.cshtml";

    // Lấy danh sách sách mẫu từ LibraryController
    var books = (Model ?? Enumerable.Empty<Library.Models.BookCardViewModel>())
        .Where(b => b.IsActive != false)
        .ToList();

    // Thống kê dữ liệu mẫu
    var totalBooks = books.Count;
    var available = books.Sum(b => b.StockQuantity);
    var totalCategories = books.Select(b => b.CategoryName)
                               .Distinct()
                               .Count();

    // Xử lý tìm kiếm tạm trên dữ liệu mẫu
    var search = (Request.QueryString["search"] ?? "").Trim();

    var filteredBooks = string.IsNullOrWhiteSpace(search)
        ? books
        : books.Where(b =>
            (b.Title ?? "").IndexOf(search, StringComparison.OrdinalIgnoreCase) >= 0 ||
            (b.AuthorName ?? "").IndexOf(search, StringComparison.OrdinalIgnoreCase) >= 0 ||
            (b.CategoryName ?? "").IndexOf(search, StringComparison.OrdinalIgnoreCase) >= 0
        ).ToList();
}

<!-- HERO SECTION -->
<section class="bn-hero">
    <div>
        <h1>Tìm cuốn sách tiếp theo của bạn</h1>

        <p>
            Kho học liệu điện tử HUFLIT:
            tra cứu, mượn và đặt trước sách ngay trên một trang.
        </p>

        <!-- Thanh tìm kiếm -->
        @using (Html.BeginForm("Index", "Library", FormMethod.Get,
            new { @class = "bn-search", role = "search" }))
        {
            <input type="search"
                   name="search"
                   value="@search"
                   placeholder="Nhập tên sách, tác giả hoặc thể loại"
                   aria-label="Tìm sách" />

            <button type="submit" class="btn btn-primary">
                Tìm sách
            </button>
        }
    </div>

    <!-- THỐNG KÊ -->
    <div class="bn-stats">

        <div class="bn-stat hl">
            <b>@totalBooks</b>
            <span>đầu sách trong kho</span>
        </div>

        <div class="bn-stat">
            <b>@available</b>
            <span>bản sách trong kho</span>
        </div>

        <div class="bn-stat">
            <b>@totalCategories</b>
            <span>thể loại</span>
        </div>

        <div class="bn-stat">
            <b>—</b>
            <span>thành viên</span>
        </div>

    </div>
</section>

<!-- DANH SÁCH SÁCH -->
<div class="d-flex justify-content-between align-items-end mb-3">

    <h2 class="h4 fw-bold m-0">
        Sách trong thư viện
    </h2>

    <a href="@Url.Action("Index", "Library")">
        Xem tất cả
    </a>

</div>

<!-- KIỂM TRA DANH SÁCH RỖNG -->
@if (!filteredBooks.Any())
{
    <p class="text-muted">
        Không tìm thấy sách phù hợp.
    </p>
}
else
{
    <!-- BOOK GRID -->
    <div class="bn-grid">

        @foreach (var b in filteredBooks)
        {
            <div class="bn-card">

                <!-- ẢNH BÌA SÁCH -->
                <div class="bn-cover">

                    <span>@b.Title</span>

                    @if (!string.IsNullOrEmpty(b.ImageUrl))
                    {
                        <img src="@Url.Content("~/Content/images/" + b.ImageUrl)"
                             alt="@b.Title"
                             onerror="this.style.display='none'" />
                    }

                </div>

                <!-- THÔNG TIN SÁCH -->
                <div class="bn-cardinfo">

                    <h3 class="text-truncate">
                        @b.Title
                    </h3>

                    <p>@b.AuthorName</p>

                    <p>Thể loại: @b.CategoryName</p>

                    <p>
                        Giá: @b.Price.ToString("N0") VNĐ
                    </p>

                    <!-- TRẠNG THÁI SỐ LƯỢNG -->
                    @if (b.StockQuantity > 0)
                    {
                        <span class="bn-badge-ok">
                            Còn @b.StockQuantity bản trong kho
                        </span>
                    }
                    else
                    {
                        <span class="bn-badge-out">
                            Hết sách
                        </span>
                    }

                </div>
            </div>
        }

    </div>
}
