@*LAYOUT DÙNG CHUNG*@


@using System
@using System.Linq

@* LAYOUT DÙNG CHUNG *@

@{
    var ctrl = (string)ViewContext.RouteData.Values["controller"];
    var action = (string)ViewContext.RouteData.Values["action"];

    Func<string, string> on = c => ctrl == c ? "on" : "";

    // Kiểm tra trạng thái đăng nhập
    bool isLoggedIn = User.Identity.IsAuthenticated;
    string username = isLoggedIn ? User.Identity.Name : "";
    string role = null;

    // Lấy vai trò tài khoản từ CSDL
    if (isLoggedIn)
    {
        using (var db = new Library.Models.LibraryManagementEntities())
        {
            role = db.Accounts
                .Where(a => a.Username == username)
                .Select(a => a.Role)
                .FirstOrDefault();
        }
    }

    bool isAdmin = string.Equals(
        role, "Admin", StringComparison.OrdinalIgnoreCase);

    bool isLibrarian = string.Equals(
        role, "Librarian", StringComparison.OrdinalIgnoreCase);

    bool isStaff = isAdmin || isLibrarian;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - BookNest</title>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="~/Content/library.css" rel="stylesheet" />

    <style>
        .bn-account {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .bn-username {
            font-size: 13px;
            font-weight: 600;
            color: #243b80;
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .bn-account form {
            margin: 0;
        }

        .bn-logout-btn {
            border: none;
            cursor: pointer;
            white-space: nowrap;
        }
    </style>
</head>

<body>
    <header class="bn-header @(isStaff ? "bn-header--staff" : "")">
        <div class="bn-wrap bn-nav">

            <!-- LOGO -->
            <a class="bn-logo"
               href="@Url.Action("Index", "Library")">
                <i>B</i>
                <span>BookNest</span>
            </a>

            <!-- MENU ĐIỀU HƯỚNG -->
            <nav class="bn-links" aria-label="Điều hướng chính">

                <!-- MENU CÔNG KHAI -->
                <a class="@(ctrl == "Library" && action == "Index" ? "on" : "")"
                   href="@Url.Action("Index", "Library")">
                    Trang chủ
                </a>

                <a class="@(ctrl == "Library" && action == "About" ? "on" : "")"
                   href="@Url.Action("About", "Library")">
                    Giới thiệu
                </a>

                <a class="@on("Books")"
                   href="@Url.Action("Index", "Books")">
                    Sách
                </a>

                <a class="@on("Categories")"
                   href="@Url.Action("Index", "Categories")">
                    Thể loại
                </a>

                <a class="@on("Authors")"
                   href="@Url.Action("Index", "Authors")">
                    Tác giả
                </a>

                <!-- MENU ADMIN VÀ LIBRARIAN -->
                @if (isStaff)
                {
                    <a class="@on("Members")"
                       href="@Url.Action("Index", "Members")">
                        Thành viên
                    </a>

                    <a class="@on("Loans")"
                       href="@Url.Action("Index", "Loans")">
                        Mượn – trả
                    </a>

                    <a class="@on("Reservations")"
                       href="@Url.Action("Index", "Reservations")">
                        Đặt trước
                    </a>
                }

                <!-- CHỈ ADMIN -->
                @if (isAdmin)
                {
                    <a class="@on("Users")"
                       href="@Url.Action("Index", "Users")">
                        Tài khoản
                    </a>
                }

            </nav>

            <!-- TÀI KHOẢN / ĐĂNG NHẬP -->
            <div class="bn-account">

                @if (isLoggedIn)
                {
                    <span class="bn-username"
                          title="@username">
                        @username
                    </span>

                    using (Html.BeginForm(
                        "Logout",
                        "Auth",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="bn-btn bn-logout-btn">
                            Đăng xuất
                        </button>
                    }
                }
                else
                {
                    <a class="bn-btn"
                       href="@Url.Action("Login", "Auth")">
                        Đăng nhập
                    </a>
                }

            </div>

        </div>
    </header>

    <main class="bn-wrap bn-main">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng">
                </button>

            </div>
        }

        @RenderBody()

    </main>

    <footer class="bn-footer">
        <div class="bn-wrap">
            Thư viện HUFLIT · BookNest &copy; @DateTime.Now.Year
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
