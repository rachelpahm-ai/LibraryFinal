@*LAYOUT DÙNG CHUNG*@

@{
    var ctrl = (string)ViewContext.RouteData.Values["controller"];
    var action = (string)ViewContext.RouteData.Values["action"];

    Func<string, string> on = c => ctrl == c ? "on" : "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - BookNest</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/library.css" rel="stylesheet" />
</head>
<body>
    <header class="bn-header">
        <div class="bn-wrap bn-nav">
            <a class="bn-logo" href="@Url.Action("Index", "Library")"><i>B</i><span>BookNest</span></a>
            <nav class="bn-links" aria-label="Điều hướng chính">
                <a class="@(ctrl == "Library" && action == "Index" ? "on" : "")"
                   href="@Url.Action("Index", "Library")">
                    Trang chủ
                </a>   
                <a class="@(ctrl == "Library" && action == "About" ? "on" : "")"
                   href="@Url.Action("About", "Library")">
                    Giới thiệu
                </a>
                <a class="@on("Books")" href="@Url.Action("Index", "Books")">Sách</a>
                <a class="@on("Categories")" href="@Url.Action("Index", "Categories")">Thể loại</a>
                <a class="@on("Authors")" href="@Url.Action("Index", "Authors")">Tác giả</a>
                <a class="@on("Members")" href="@Url.Action("Index", "Members")">Thành viên</a>
                @* Lần 3 thêm: Mượn trả (Loans), Đặt trước (Reservations), Thống kê *@
            </nav>
            <a class="bn-btn" href="@Url.Action("Create", "Users")">Đăng nhập</a> @* TODO lần 3: đổi sang Account/Login *@
        </div>
    </header>

    <main class="bn-wrap bn-main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bn-footer">
        <div class="bn-wrap">Thư viện HUFLIT · BookNest &copy; @DateTime.Now.Year</div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
